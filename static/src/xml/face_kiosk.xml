<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="face_attendance.FaceKiosk" owl="1">
        <div class="o_face_kiosk_container">
            <div class="kiosk_header">
                <h1>HỆ THỐNG ĐIỂM DANH KHUÔN MẶT</h1>
                <p class="status_text" t-att-class="state.statusClass"><t t-esc="state.statusMessage"/></p>
            </div>
            
            <div class="video_wrapper">
                <video id="kiosk_video" autoplay="1" muted="1" playsinline="1"></video>
                <div t-if="state.loading" class="loader">Đang tải AI...</div>
            </div>

            <div class="info_card" t-if="state.lastEmployee">
                <h3>Xin chào, <t t-esc="state.lastEmployee"/>!</h3>
                <p>Bạn đã điểm danh <t t-esc="state.lastAction"/> thành công.</p>
            </div>
        </div>
    </t>
</templates>
